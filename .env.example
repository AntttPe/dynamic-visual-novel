# Skopiuj do .env i uzupełnij:  cp .env.example .env
# Plik .env NIE trafia do repo.

# --- Klucze API (uzupełnij te, których używasz) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Lokalny LLM (Ollama) ---
# macOS: uruchom Ollamę natywnie na hoście (GPU/Metal) -> http://host.docker.internal:11434
# Linux/Windows z NVIDIA + profil local-gpu -> http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# --- Hot reload ---
# Ustaw na true, jeśli zmiany w plikach nie przeładowują aplikacji
# (typowo: Windows z repo na C:\ zamiast w WSL2)
WATCHFILES_FORCE_POLLING=false
