# Skopiuj do .env i uzupełnij:  cp .env.example .env
# Plik .env NIE trafia do repo.

# --- Klucze API (uzupełnij te, których używasz) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Lokalny LLM (Ollama) ---
# macOS: uruchom Ollamę natywnie na hoście (GPU/Metal) -> http://host.docker.internal:11434
# Linux/Windows z NVIDIA + profil local-gpu -> http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# --- Narrator (model językowy) ---
# Format LiteLLM: <provider>/<model>. Puste = Ollama z OLLAMA_MODEL powyżej.
# Przykłady:
#   ollama_chat/gemma4:12b        Ollama na Macu albo na wynajętym GPU (adres: OLLAMA_BASE_URL)
#   hosted_vllm/Qwen/Qwen3-8B     vLLM na wynajętym GPU (adres: NARRATOR_API_BASE)
#   anthropic/claude-haiku-5-5    API (wymaga ANTHROPIC_API_KEY)
#   demo                          bez modelu, tylko do oglądania UI
NARRATOR_MODEL=
# Serwer zgodny z API OpenAI dla modeli openai/... i hosted_vllm/...
# Serwer uczelni: NARRATOR_MODEL=openai/strata-big, adres i klucz od prowadzącego (tylko w .env!)
# vLLM przez tunel SSH: http://host.docker.internal:8001/v1
NARRATOR_API_BASE=
NARRATOR_API_KEY=
NARRATOR_TEMPERATURE=0.7

# --- Pamięć narratora ---
# window = ostatnie N tur, full = pełna historia
MEMORY_HISTORY=window
MEMORY_WINDOW=8
MEMORY_STATE_IN_PROMPT=true

# --- Git w kontenerze (dla commitów robionych w środku) ---
# Odkomentuj i wpisz swoje dane, takie same jak w GitHubie
# GIT_AUTHOR_NAME=Imię Nazwisko
# GIT_AUTHOR_EMAIL=twoj@email.pl
# GIT_COMMITTER_NAME=Imię Nazwisko
# GIT_COMMITTER_EMAIL=twoj@email.pl

# --- Hot reload ---
# Ustaw na true, jeśli zmiany w plikach nie przeładowują aplikacji
# (typowo: Windows z repo na C:\ zamiast w WSL2)
WATCHFILES_FORCE_POLLING=false
